{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development-student": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_TARGET": "student",
        "EXPO_PUBLIC_APP_TARGET": "student"
      }
    },
    "development-teacher": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_TARGET": "teacher",
        "EXPO_PUBLIC_APP_TARGET": "teacher"
      }
    },
    "preview-student": {
      "distribution": "internal",
      "env": {
        "APP_TARGET": "student",
        "EXPO_PUBLIC_APP_TARGET": "student"
      }
    },
    "preview-teacher": {
      "distribution": "internal",
      "env": {
        "APP_TARGET": "teacher",
        "EXPO_PUBLIC_APP_TARGET": "teacher"
      }
    },
    "production-student": {
      "autoIncrement": true,
      "env": {
        "APP_TARGET": "student",
        "EXPO_PUBLIC_APP_TARGET": "student"
      }
    },
    "production-teacher": {
      "autoIncrement": true,
      "env": {
        "APP_TARGET": "teacher",
        "EXPO_PUBLIC_APP_TARGET": "teacher"
      }
    }
  }
}
